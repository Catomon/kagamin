    val all = listOf(Tsukaremi, Kagami, Miyuki, Konata)

    val default = Tsukaremi

    fun byName(name: String?): V3Colors =
        when (name) {
            "yuki" -> Miyuki
            else -> all.firstOrNull { it.name == name } ?: default
        }
